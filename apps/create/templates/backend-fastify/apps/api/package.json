{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run --if-present db:generate && tsx watch src/main.ts",
    "build": "pnpm run --if-present db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "check-types": "pnpm run --if-present db:generate && tsc --noEmit",
    "lint": "eslint src test",
    "test": "pnpm run --if-present db:generate && vitest run",
    "test:e2e": "pnpm run --if-present db:generate && vitest run --config vitest.config.e2e.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "dotenv": "18.0.7",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@devwebdex/eslint-config": "^0.1.0",
    "@devwebdex/tsconfig": "^0.1.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
