{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run --if-present db:generate && tsx watch src/main.ts",
    "build": "pnpm run --if-present db:generate && tsc",
    "start": "node dist/main.js",
    "check-types": "pnpm run --if-present db:generate && tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@devwebdex/eslint-config": "^0.1.0",
    "@devwebdex/tsconfig": "^0.1.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
