{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ace serve --hmr",
    "build": "node ace build",
    "start": "node --env-file-if-exists=.env build/bin/server.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node ace test unit",
    "test:e2e": "node ace test functional",
    "db:migrate": "node ace migration:run",
    "db:deploy": "node ace migration:run --force"
  },
  "imports": {
    "#modules/*": "./app/modules/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "dependencies": {
    "@adonisjs/core": "7.6.0",
    "@adonisjs/cors": "3.0.0",
    "@adonisjs/lucid": "22.4.2",
    "@vinejs/vine": "4.4.0",
    "luxon": "3.7.2",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.5.2",
    "@adonisjs/tsconfig": "2.0.0",
    "@devwebdex/eslint-config": "^0.1.0",
    "@japa/api-client": "3.2.1",
    "@japa/assert": "4.2.0",
    "@japa/plugin-adonisjs": "5.2.0",
    "@japa/runner": "5.4.0",
    "@poppinss/ts-exec": "1.5.0",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "hot-hook": "1.0.0",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3",
    "youch": "4.1.1"
  },
  "hotHook": {
    "boundaries": [
      "./app/modules/**/*_controller.ts",
      "./app/middleware/*.ts"
    ]
  }
}
