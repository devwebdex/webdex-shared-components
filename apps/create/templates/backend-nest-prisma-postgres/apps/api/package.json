{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "check-types": "prisma generate && tsc --noEmit",
    "lint": "eslint src",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@devwebdex/eslint-config": "^0.1.0",
    "@devwebdex/tsconfig": "^0.1.0",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3"
  }
}
