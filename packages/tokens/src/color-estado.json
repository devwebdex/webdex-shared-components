{
  "color": {
    "$type": "color",
    "$description": "Escada de alpha de estado do Figma, aplicada a cada cor base: hover 8%, focus 12%, disabled 18%, pressed 28%, selected 42%, active 56%. Sao as colecoes Cores Primitivas (branco e preto), Cores Semanticas (success, danger, warning, info) e o grupo Brand Surface de Cores da Marca. Arquivo separado do color.json de proposito: e uma tabela gerada, e PR nova nao precisa editar o arquivo das cores base.",

    "white": { "$value": "#ffffff" },
